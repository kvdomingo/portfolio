---
import { ClientRouter } from "astro:transitions";

import Posthog from "@/analytics/posthog.astro";
import Umami from "@/analytics/umami.astro";
import Navbar from "@/components/common/Navbar.astro";
import "@/styles/base.css";
import "@fontsource-variable/figtree";
import "@fontsource-variable/rubik";
import "@fontsource-variable/space-grotesk";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";

import info from "@/info.json";

interface Props {
  title?: string;
  image?: string;
  description?: string;
}

const {
  title = info.title,
  image = "https://res.cloudinary.com/kdphotography-assets/image/upload/v1/logo/logo-black.png",
  description,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark mocha">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="delegate-ch"
      content="sec-ch-width https://res.cloudinary.com; sec-ch-dpr https://res.cloudinary.com; sec-ch-viewport-width https://res.cloudinary.com;"
    />
    <link
      rel="icon"
      href="https://res.cloudinary.com/kdphotography-assets/image/upload/v1/logo/favicon.png"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="apple-touch-icon" href="/logo-black.png" />

    <meta name="p:domain_verify" content="8e4753adcb7e777965ab4bcea65b7c85" />

    <meta name="author" content="Kenneth V. Domingo" />

    <meta property="og:url" content="https://kvd.studio" />
    <meta property="og:site_name" content={info.title} />
    <meta property="og:title" content={info.title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:image" content={image} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}

    <meta
      property="twitter:card"
      content={Astro.props.image ? "summary_large_image" : "summary"}
    />
    <meta property="twitter:creator" content="@rockentothemoon" />
    <meta property="twitter:site" content="@rockentothemoon" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={info.title} />
    <meta name="twitter:image:alt" content={info.title} />

    <meta
      name="google-site-verification"
      content="O8dXlE8aWPqHSuA4FwbY6-L1AjW7ch4613PIr_5_fII"
    />

    <title>{title}</title>

    <script is:inline>
      // Registered before ClientRouter's listener so the photo lightbox can
      // claim its history entries (capture doesn't preempt it at the window).
      addEventListener("popstate", e => window.__lightboxPopState?.(e));
    </script>
    <ClientRouter />
    <Umami />
  </head>

  <body class="min-h-screen bg-linear-to-b from-ctp-base to-ctp-crust">
    <Navbar />

    <main>
      <slot />
    </main>

    <Posthog />

    <style is:global>
      body {
        margin: 0;
        padding: 0;
        font-family: "Figtree Variable", "Rubik Variable", sans-serif;
        color: var(--color-ctp-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: var(--color-ctp-text);
      }

      code {
        color: var(--color-ctp-mauve);
        font-family:
          "Inconsolata", "Space Mono", source-code-pro, Menlo, Monaco, Consolas,
          "Courier New", monospace;
      }

      .section-header {
        letter-spacing: 0.25em;
        text-transform: uppercase;
      }

      a[href] {
        color: var(--color-ctp-mauve);
        text-decoration: none;
      }

      ol.reference {
        counter-reset: spp-counter;
        list-style: none;
      }

      ol.reference li {
        counter-increment: spp-counter;
      }

      ol.reference li::before {
        content: "[" counter(spp-counter) "]";
        margin-left: -2rem;
        margin-right: 1rem;
      }

      .math-container {
        overflow-x: auto;
      }
    </style>
  </body>
</html>
